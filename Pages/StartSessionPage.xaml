<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pageModels="clr-namespace:WalkBuddy.PageModels"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="WalkBuddy.Pages.StartSessionPage"
             x:DataType="pageModels:StartSessionPageModel"
             x:Name="StartPage"
             Title="Start">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference StartPage}}"
            EventName="Appearing"
            Command="{Binding InitialDataLoadCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" 
                         Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Good morning," FontSize="14" TextColor="#999999" />
                <Label Text="{Binding User.Username}" FontSize="26" FontAttributes="Bold" TextColor="#1A1A1A" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="How are you feeling right now?"
                       FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" />
                <Label Text="Choose the emotion that feels closest."
                       FontSize="13" TextColor="#999999" />
            </VerticalStackLayout>

            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Emotions}"
                                   Spacing="8"
                                   HorizontalOptions="Center">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <Border Stroke="{StaticResource Outline}"
                                StrokeShape="RoundRectangle 8"
                                WidthRequest="64">
                            <VerticalStackLayout Padding="8"
                                                 Spacing="8">
                                <Ellipse Fill="{StaticResource Outline}"
                                         WidthRequest="40"
                                         HeightRequest="40" />
                                <Label Text="{Binding .}"
                                       FontSize="10"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource OnSurface}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Text="You can change this during your walk."
                   FontSize="12" TextColor="#BBBBBB" HorizontalTextAlignment="Center" />

                <Border Stroke="#EDEDED" StrokeThickness="1" Background="#F8F8F8"
                    Padding="12,10" StrokeShape="RoundRectangle 12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="" FontSize="18" />
                        <Label Text="3 walks completed. Last walk 2 days ago."
                           FontSize="13" TextColor="#777777" />
                    </HorizontalStackLayout>
                </Border>

                <buttons:SfButton Text="Start walk" HeightRequest="56" CornerRadius="14"
                              Clicked="StartWalk_Clicked" />
                <Label Text="Select an emotion above to begin"
                   FontSize="12" TextColor="#C0C0C0" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
