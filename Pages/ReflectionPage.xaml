<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:WalkBuddy.PageModels"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WalkBuddy.Pages.ReflectionPage"
             x:DataType="pageModels:ReflectionPageModel"
             Title="Reflection"
             HideSoftInputOnTapped="True"
              Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False, IsEnabled=False}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,28" Spacing="16">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border WidthRequest="60" HeightRequest="60"
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        Stroke="{StaticResource Outline}"
                        StrokeShape="RoundRectangle 30">
                    <Label Text="🌿" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Walk complete"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnSurface}" />

                <Label Text="{Binding SubtitleText}"
                       FontSize="13"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Label Text="How are you feeling now?"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   TextTransform="Uppercase" />

            <chips:SfChipGroup ItemsSource="{Binding Emotions}"
                               SelectedItem="{Binding SelectedEmotionName}"
                               ChipType="Choice">
                <chips:SfChipGroup.ChipLayout>
                    <FlexLayout Wrap="Wrap" />
                </chips:SfChipGroup.ChipLayout>
            </chips:SfChipGroup>

            <Label Text="Anything to note?"
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}" />

            <Border Stroke="{StaticResource Outline}"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,8">
                <Editor Text="{Binding Note}"
                        HeightRequest="90"
                        TextColor="{StaticResource OnSurface}"
                        Placeholder="A short note is enough…" />
            </Border>

            <buttons:SfButton Text="Save and finish"
                              Command="{Binding SaveCommand}"
                              Style="{StaticResource FilledButton}" />

            <Label Text="Skip reflection"
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SkipCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
