<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             x:Class="WalkBuddy.Pages.NaturePromptPage"
             Title="Your walk">
    <ScrollView>
        <VerticalStackLayout Padding="20,14,20,28" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Your walk" FontSize="17" FontAttributes="Bold" TextColor="#1A1A1A" />
                <Label Grid.Column="1" Text="22 min" FontSize="12" TextColor="#AAAAAA" />
            </Grid>

            <Border Stroke="#E4E4E4" Background="#FFFFFF" Padding="12,6"
                    StrokeShape="RoundRectangle 18" HorizontalOptions="Start">
                <Label Text="Feeling: Stressed" FontSize="12" TextColor="#666666" />
            </Border>

            <Border Stroke="#E8E8E8" Background="#F8F8F8" Padding="20"
                    StrokeShape="RoundRectangle 18">
                <Grid>
                    <Label Text="Notice the colours around you. Find one that stands out and follow it with your eyes."
                           FontSize="18" TextColor="#1A1A1A" LineHeight="1.6" />
                    <Border Background="#FFFFFF" Stroke="#E0E0E0" WidthRequest="44" HeightRequest="44"
                            StrokeShape="RoundRectangle 22" HorizontalOptions="End" VerticalOptions="Start">
                        <Label Text="" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <Label Text="How are you feeling now?"
                   FontSize="12" FontAttributes="Bold" TextColor="#AAAAAA"
                   TextTransform="Uppercase" />

            <chips:SfChipGroup>
                <chips:SfChip Text="Stressed" />
                <chips:SfChip Text="Anxious" />
                <chips:SfChip Text="Sad" />
                <chips:SfChip Text="Neutral" />
                <chips:SfChip Text="Content" />
            </chips:SfChipGroup>

            <buttons:SfButton Text="New prompt" HeightRequest="52" CornerRadius="14" />
            <buttons:SfButton Text="End session" HeightRequest="48" CornerRadius="14"
                              Clicked="EndSession_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
