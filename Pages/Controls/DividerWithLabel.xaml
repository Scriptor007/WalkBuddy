<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WalkBuddy.Pages.Controls"
             x:Class="WalkBuddy.Pages.Controls.DividerWithLabel"
             x:DataType="local:DividerWithLabel">

    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" ColumnSpacing="8">
        <Label Grid.Column="0"
           Text="{Binding LabelText}"
           VerticalOptions="Center" 
           HorizontalOptions="Start"
           TextColor="{StaticResource Gray300}"
           FontAttributes="Bold" />
        <BoxView Grid.Column="1"
             HeightRequest="1"
             Color="{StaticResource Gray200}"
             VerticalOptions="Center" />
        <Label Grid.Column="2"
               Text="optional"
               VerticalOptions="Center"
               TextColor="{StaticResource Gray200}" />
    </Grid>
</ContentView>
