<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WalkBuddy.Pages.CheckInPage"
             xmlns:pageModels="clr-namespace:WalkBuddy.PageModels"
             x:DataType="pageModels:CheckInPageModel"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:ChipControl="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             x:Name="CheckIn"
             Title="Check in">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CheckIn}}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CheckIn}}"
            EventName="Disappearing"
            Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto"
                  Padding="20, 16, 20, 8">
                <Label Grid.Column="0"
                       Text="Your walk"
                       TextColor="{StaticResource OnSurface}"
                       FontSize="16" />
                <Label Grid.Column="1" 
                       Text="{Binding TimerService.MinPassed, StringFormat='{0} min'}" 
                       TextColor="{StaticResource OnSurfaceVariant}"
                       FontSize="16" />
            </Grid>

            <BoxView HeightRequest="1"
                     Color="{StaticResource Outline}" />

            <VerticalStackLayout Padding="20"
                                 Spacing="16">
                <Label Text="How did that feel?"
                       FontSize="22"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="You just tried:"
                           FontSize="11"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Border Stroke="{StaticResource Outline}"
                            StrokeShape="RoundRectangle 8"
                            Background="{StaticResource Surface}"
                            Padding="8">
                        <Label Text="{Binding MistralAnswer}"
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Choose a feeling:"
                           FontSize="11"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Border Stroke="{StaticResource Outline}"
                            StrokeShape="RoundRectangle 8"
                            Padding="0, -16, 0, 8"
                            Background="{StaticResource Surface}">
                        <ChipControl:SfChipGroup SelectedItem="{Binding CheckIn}"
                                                 ChipType="Choice">
                            <ChipControl:SfChipGroup.Items>
                                <ChipControl:SfChip Text="Grounding - Felt anchored and present"
                                                    Margin="0, 8, 0, 0"
                                                    Stroke="{StaticResource Outline}" />
                                <ChipControl:SfChip Text="Uplifting - Felt lighter or more positive"
                                                    Margin="0, 8, 0, 0"
                                                    Stroke="{StaticResource Outline}"/>
                                <ChipControl:SfChip Text="Calming - Felt less activated, more peaceful"
                                                    Margin="0, 8, 0, 0"
                                                    Stroke="{StaticResource Outline}"/>
                                <ChipControl:SfChip Text="Didn't quite land - Prompt didn't fit"
                                                Margin="0, 8, 0, 0"
                                                Stroke="{StaticResource Outline}"/>
                            </ChipControl:SfChipGroup.Items>
                            <ChipControl:SfChipGroup.ChipLayout>
                                <FlexLayout Wrap="Wrap"
                                            Padding="16"/>
                            </ChipControl:SfChipGroup.ChipLayout>
                        </ChipControl:SfChipGroup>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <buttons:SfButton Style="{StaticResource FilledButton}"
                                      Text="Next prompt"
                                      Command="{Binding NextPromptCommand}"/>
                    
                    <buttons:SfButton Text="End walk"
                                      Background="Transparent"
                                      TextColor="{StaticResource Primary}"
                                      CornerRadius="8"
                                      Stroke="{StaticResource Outline}"
                                      StrokeThickness="1"
                                      FontFamily="RobotoMedium"
                                      Command="{Binding EndSessionCommand}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>