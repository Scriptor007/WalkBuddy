<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WalkBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:WalkBuddy.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="WalkBuddy"
    Shell.TabBarTitleColor="{StaticResource OnSurface}">

    <TabBar>
        <Tab Title="Start">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="&#xE88A;"
                                 Color="{StaticResource OnSurfaceVariant}" />
            </Tab.Icon>
            <ShellContent
                x:Name="homepage"
                Title="Homepage"
                ContentTemplate="{DataTemplate pages:MainPage}"
                Route="homepage" />
        </Tab>
        <Tab Title="Edit">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                     Glyph="&#xE8B8;"
                     Color="{StaticResource OnSurfaceVariant}" />
            </Tab.Icon>
            <ShellContent
                x:Name="edit"
                Title="Profile"
                ContentTemplate="{DataTemplate pages:EditProfilePage}"
                Route="edit" />
        </Tab>
    </TabBar>
</Shell>
