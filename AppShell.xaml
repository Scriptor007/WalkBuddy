<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WalkBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:WalkBuddy.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="WalkBuddy"
    Shell.TabBarTitleColor="{StaticResource OnSurface}">

    <ShellContent Title="Onboarding"
                  Route="onboarding"
                  ContentTemplate="{DataTemplate pages:OnboardingPage}"
                  Shell.TabBarIsVisible="False" />

    <TabBar>
        <Tab Title="Start">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="&#xE88A;"
                                 Color="{StaticResource OnSurfaceVariant}" />
            </Tab.Icon>
            <ShellContent
                Title="Start"
                ContentTemplate="{DataTemplate pages:StartSession}"
                Route="start" />
        </Tab>
        <Tab Title="Sessions">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="&#xE8B5;"
                                 Color="{StaticResource OnSurfaceVariant}" />
            </Tab.Icon>
            <ShellContent
                Title="Sessions"
                ContentTemplate="{DataTemplate pages:MainPage}"
                Route="sessions" />
        </Tab>
        <Tab Title="Settings">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="&#xE8B8;"
                                 Color="{StaticResource OnSurfaceVariant}" />
            </Tab.Icon>
            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate pages:EditProfilePage}"
                Route="settings" />
        </Tab>
    </TabBar>
</Shell>