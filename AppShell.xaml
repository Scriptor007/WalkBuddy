<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WalkBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:WalkBuddy.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="WalkBuddy">

    <TabBar>
        <Tab Title="Homepage">
            <ShellContent
                x:Name="homepage"
                Title="Homepage"
                ContentTemplate="{DataTemplate pages:MainPage}"
                Route="homepage" />
        </Tab>
        <Tab Title="Edit">
            <ShellContent
                x:Name="edit"
                Title="Profile"
                ContentTemplate="{DataTemplate pages:EditProfilePage}"
                Route="edit" />
        </Tab>
    </TabBar>
</Shell>
