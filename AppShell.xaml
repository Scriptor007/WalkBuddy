<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WalkBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:WalkBuddy.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="WalkBuddy">

    <TabBar>
        <Tab Title="Home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate pages:StartSession}"
                Route="start" />
        </Tab>
        <Tab Title="Sessions">
            <ShellContent
                Title="Sessions"
                ContentTemplate="{DataTemplate pages:StartSession}"
                Route="sessions" />
        </Tab>
        <Tab Title="Settings">
            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate pages:StartSession}"
                Route="settings" />
        </Tab>
    </TabBar>

    <ShellContent
        Title="Onboarding"
        ContentTemplate="{DataTemplate pages:OnboardingPage}"
        Route="onboarding" />
</Shell>
