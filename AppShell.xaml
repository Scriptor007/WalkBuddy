<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WalkBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:WalkBuddy.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="WalkBuddy">

    <TabBar>
        <Tab Title="Start">
            <ShellContent
                Title="Start"
                ContentTemplate="{DataTemplate pages:StartSession}"
                Route="start" />
        </Tab>
        <Tab Title="Onboarding">
            <ShellContent
                Title="Onboarding"
                ContentTemplate="{DataTemplate pages:OnboardingPage}"
                Route="onboarding" />
        </Tab>
    </TabBar>
</Shell>
